{
  "manifest_version": 3,
  "name": "ARGUS: digital trust for what you post and see",
  "version": "0.5.0",
  "description": "Checks your comments in the context of the post before they go out, checks images for AI, harm, private details and registered work, and shows who is verified behind a post. Talks to your ARGUS server.",
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://sh.reddit.com/*",
        "https://www.instagram.com/*",
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "moderator.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.reddit.com/*",
        "*://*.youtube.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "lens.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.reddit.com/*",
        "https://sh.reddit.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "identity.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ARGUS",
    "default_popup": "popup.html"
  }
}
