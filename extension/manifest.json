{
  "manifest_version": 3,
  "name": "ARGUS: digital trust for what you post and see",
  "version": "0.7.0",
  "description": "Checks what you write in any text box, on any site, before it is sent: in the context of the post, with a better way to say it. Checks images for AI, harm, private details and registered work, and shows who is verified behind a post. Talks to your ARGUS server.",
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "moderator.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lens.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.reddit.com/*",
        "https://sh.reddit.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "identity.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ARGUS",
    "default_popup": "popup.html"
  }
}
