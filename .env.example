# Copy to .env. Keys stay on the server and are never sent to the browser or the extension.
PORT=8787

# Comment moderator (ai-moderator-plugin/): NVIDIA Nemotron on Nebius Token Factory while its
# credits last, then MiniMax. Leave NEBIUS_API_KEY empty to use MiniMax only.
NEBIUS_API_KEY=
# Optional: your remaining Nebius credit in US$. Spend is estimated from token counts and
# Nemotron stops when it reaches this. Without it, the switch happens only when Nebius refuses.
NEBIUS_CREDIT_USD=
# Optional: list prices used for that estimate (US$ per million tokens).
# NEMOTRON_PRICE_IN=1.00
# NEMOTRON_PRICE_OUT=3.00
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
# Optional: enables GET /api/plugin/queue and POST /api/plugin/resolve (header x-moderator-admin).
ARGUS_MODERATOR_SECRET=

# Argus Lens (lens/, the /lens page and the extension's image checks): Meta Model API
# (Muse Wonder + SAM 3.1). Paid, with no cheaper backup model: when the credits are used up,
# Lens answers "Couldn't check" instead of spending more.
MODEL_API_KEY=
# Optional: your remaining Meta credit in US$. Lens estimates spend and stops when it reaches this.
META_CREDIT_USD=

# Browser extension. Optional locally; on a public deployment it is how the extension gets past
# the password. Put the same value in the extension's settings.
ARGUS_EXTENSION_KEY=

# Public deployment only (Render sets RENDER automatically): HTTP Basic Auth for the Lens page.
ARGUS_USER=argus
ARGUS_PASSWORD=

# Optional: Supabase, so credit spend and moderator decisions survive restarts on hosts with no
# disk. Run supabase/argus-state.sql once. Use the service-role key only on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin page (/admin: reviewer queue, identity credentials, content registry). Required on a public
# deployment. Locally, if unset, the server prints a fresh key for each run when it starts.
ARGUS_ADMIN_SECRET=
# Optional: pin the Ed25519 key that signs content registrations and credentials (PKCS#8 PEM,
# line breaks written as \n). Otherwise one is made on first run in data/runtime/signing-key.json.
ARGUS_SIGNING_KEY=
